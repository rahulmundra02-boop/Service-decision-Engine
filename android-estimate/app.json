{
  "expo": {
    "name": "AL Service Estimate Beta",
    "slug": "al-service-estimate-beta",
    "version": "0.2.3",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.rahulmundra.serviceestimate.beta",
      "versionCode": 111,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "6da46a08-1b23-4b64-82f4-c4ca30103f6b"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to select the user signature or letterhead photo.",
          "cameraPermission": "Allow camera access to capture the user signature photo.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Allow camera access to scan the estimate letterhead."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Service Estimate to use biometric authentication."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ]
  }
}
